  "thinking_policy": {
    "notes": [
      "Calibrate thinking policy before changing model-cost routing so reasoning depth is tuned separately from provider/model choice.",
      "Critical roles keep a high-thinking floor even when cost pressure is present.",
      "Budget-mode caps and reason-based adjustments are deterministic and machine-readable so tuning stays reviewable."
    ],
    "level_order": [
      "off",
      "minimal",
      "low",
      "medium",
      "high",
      "xhigh"
    ],
    "reason_adjustments": {
      "default": 0,
      "task_simpler": -1,
      "task_harder": 2,
      "provider_failure": 0,
      "budget_pressure": -1,
      "recovery_recommendation": 0,
      "human_override": 0
    },
    "budget_mode_caps": {
      "default": "xhigh",
      "balanced": "high",
      "conserve": "low",
      "high": "xhigh"
    },
    "critical_role_minimum": "high"
  },
  "tuning_history": [
    {
      "date": "2026-04-24",
      "scope": "HARNESS-039 closeout",
      "inputs": [
        "harness routing validator timings",
        "queue-runner validator timings",
        "core workflow validator timings",
        "scheduled workflow dry-run timings"
      ],
      "before": [
        "build_lead default thinking was medium with no budget override path.",
        "frontend_worker and backend_worker default thinking were medium.",
        "task_harder raised thinking by only one level, which would have become too weak after cheaper default thinking changes.",
        "balanced and conserve budget modes capped thinking at xhigh and medium respectively."
      ],
      "after": [
        "build_lead now defaults to low thinking and may use GitHub Copilot gpt-5.4-mini under explicit budget pressure or simpler-task routing.",
        "frontend_worker and backend_worker now default to low thinking while task_harder raises them by two levels to preserve high-effort escalation.",
        "balanced mode now caps at high and conserve mode caps at low for non-critical roles.",
        "Critical roles still retain a high-thinking floor and do not gain new budget override paths."
      ],
      "rationale": "Local validator timings showed the routing validator dominating runtime, so the cheapest safe next move was to reduce default reasoning depth and add one new non-critical budget override path before touching critical-role model defaults."
    }
  ],
