{
  "version": 1,
  "packageName": "pi-repo-local-harness",
  "packageVersion": "0.1.0",
  "notes": [
    "HARNESS-040 package manifest for staging/bootstrap of reusable harness assets.",
    "Reusable assets are copied directly; repo-local assets are generated from templates or left for manual review.",
    "Runtime history, logs, reports, and repo VCS metadata must never be copied by the bootstrap helper."
  ],
  "reusableAssets": [
    ".pi/agent/settings.json",
    ".pi/agent/docs",
    ".pi/agent/extensions",
    ".pi/agent/handoffs",
    ".pi/agent/governance",
    ".pi/agent/intake",
    ".pi/agent/lifecycle",
    ".pi/agent/package",
    ".pi/agent/packets",
    ".pi/agent/release",
    ".pi/agent/prompts",
    ".pi/agent/recovery",
    ".pi/agent/routing",
    ".pi/agent/schedules",
    ".pi/agent/skills",
    ".pi/agent/state/schemas",
    ".pi/agent/teams",
    ".pi/agent/validation",
    "scripts",
    "tests"
  ],
  "generatedFiles": [
    {
      "target": "AGENTS.md",
      "template": ".pi/agent/package/templates/AGENTS.template.md",
      "mode": "create_if_missing",
      "requiredReview": true,
      "notes": [
        "Project-specific agent rules should be reviewed and customized after bootstrap."
      ]
    },
    {
      "target": "SYSTEM.md",
      "template": ".pi/agent/package/templates/SYSTEM.template.md",
      "mode": "create_if_missing",
      "requiredReview": true,
      "notes": [
        "System guidance should be reviewed and customized after bootstrap."
      ]
    },
    {
      "target": ".pi/APPEND_SYSTEM.md",
      "template": ".pi/agent/package/templates/SYSTEM.template.md",
      "mode": "create_if_missing",
      "requiredReview": true,
      "notes": [
        "pi appends this file to its default system prompt; a root SYSTEM.md is not read by pi."
      ]
    },
    {
      "target": ".pi/agent/models.json",
      "template": ".pi/agent/models.json",
      "mode": "create_if_missing",
      "requiredReview": true,
      "notes": [
        "Copied from the source harness's live routing map; routing defaults are a starting point and may need repo/provider adjustments."
      ]
    },
    {
      "target": ".pi/agent/state/runtime/tasks.json",
      "template": ".pi/agent/package/templates/runtime/tasks.json",
      "mode": "create_if_missing",
      "requiredReview": false,
      "notes": [
        "Fresh runtime task state placeholder."
      ]
    },
    {
      "target": ".pi/agent/state/runtime/queue.json",
      "template": ".pi/agent/package/templates/runtime/queue.json",
      "mode": "create_if_missing",
      "requiredReview": false,
      "notes": [
        "Fresh runtime queue state placeholder."
      ]
    },
    {
      "target": ".pi/agent/state/runtime/scheduled-workflows.json",
      "template": ".pi/agent/package/templates/runtime/scheduled-workflows.json",
      "mode": "create_if_missing",
      "requiredReview": false,
      "notes": [
        "Fresh scheduled workflow runtime state placeholder."
      ]
    },
    {
      "target": ".pi/agent/state/runtime/leases.json",
      "template": ".pi/agent/package/templates/runtime/leases.json",
      "mode": "create_if_missing",
      "requiredReview": false,
      "notes": [
        "Fresh execution lease runtime state placeholder."
      ]
    },
    {
      "target": "docs/product/intake-policy.md",
      "template": ".pi/agent/package/templates/docs/product/intake-policy.template.md",
      "mode": "create_if_missing",
      "requiredReview": true,
      "notes": [
        "Review and tailor the intake policy for the target repo's product and governance expectations."
      ]
    },
    {
      "target": "docs/initiatives/README.md",
      "template": ".pi/agent/package/templates/docs/initiatives/README.template.md",
      "mode": "create_if_missing",
      "requiredReview": false,
      "notes": [
        "Explains how major features should use initiative folders."
      ]
    },
    {
      "target": "docs/initiatives/TEMPLATE/prd.md",
      "template": ".pi/agent/package/templates/docs/initiatives/TEMPLATE/prd.template.md",
      "mode": "create_if_missing",
      "requiredReview": false,
      "notes": [
        "PRD template for major feature initiative folders."
      ]
    },
    {
      "target": "docs/initiatives/TEMPLATE/backlog.md",
      "template": ".pi/agent/package/templates/docs/initiatives/TEMPLATE/backlog.template.md",
      "mode": "create_if_missing",
      "requiredReview": false,
      "notes": [
        "Backlog template for major feature initiative folders."
      ]
    },
    {
      "target": "docs/initiatives/TEMPLATE/decisions.md",
      "template": ".pi/agent/package/templates/docs/initiatives/TEMPLATE/decisions.template.md",
      "mode": "create_if_missing",
      "requiredReview": false,
      "notes": [
        "Decision log template for major feature initiative folders."
      ]
    },
    {
      "target": "tsconfig.harness.json",
      "template": ".pi/agent/package/templates/tsconfig.harness.template.json",
      "mode": "create_if_missing",
      "requiredReview": false,
      "notes": [
        "TypeScript settings for the harness's own code, used by `npm run harness:check`; independent of the target repo's tsconfig.json."
      ]
    },
    {
      "target": ".githooks/pre-push",
      "template": ".githooks/pre-push",
      "mode": "create_if_missing",
      "requiredReview": false,
      "notes": [
        "Runs `npm run harness:check` before every push once enabled with `npm run harness:hooks:install`. A target's own pre-push hook is kept."
      ]
    }
  ],
  "packageJsonTemplate": ".pi/agent/package/templates/package.template.json",
  "piSettingsTemplate": ".pi/settings.json",
  "piSettingsKeys": [
    "extensions",
    "skills",
    "prompts",
    "enableSkillCommands"
  ],
  "gitignoreEntries": [
    ".pi/agent/pi-session-*.html",
    ".pi/agent/artifacts/",
    ".pi/agent/state/runtime/*.json",
    ".pi/agent/state/runtime/*.lock",
    "**/.pi/agent/state/runtime/pi.db*",
    "logs/harness-actions.jsonl*",
    "**/logs/harness-actions.jsonl*"
  ],
  "versionRecordTarget": ".pi/agent/package/installed-package.json",
  "excludedPaths": [
    ".git",
    "node_modules",
    "logs",
    "reports",
    ".pi/agent/state/runtime",
    ".pi/agent/artifacts",
    ".pi/agent/package/installed-package.json",
    ".pi/agent/pi-session-*.html",
    "tests/integration/auth-boundary.test.ts",
    "tests/integration/health-handshake.test.ts",
    "tests/integration/observability.test.ts",
    "tests/integration/greenfield-phase-b-queue-readiness.test.ts",
    "tests/integration/greenfield-phase-c-worker-proof.test.ts",
    "tests/integration/orchestrator-context.test.ts",
    "tests/extension-units/second-model-opus.test.ts",
    "tests/extension-units/project-model-settings.test.ts"
  ]
}
