{
  "name": "repo-local-pi-harness-dev",
  "private": true,
  "type": "module",
  "scripts": {
    "harness:status": "node --import tsx scripts/harness-operator-status.ts",
    "harness:status:json": "node --import tsx scripts/harness-operator-status.ts --json",
    "harness:worktree": "node --import tsx scripts/harness-worktree.ts",
    "harness:worktree:status": "node --import tsx scripts/harness-worktree.ts status",
    "harness:schedules": "node --import tsx scripts/harness-scheduled-workflows.ts status",
    "harness:schedules:json": "node --import tsx scripts/harness-scheduled-workflows.ts status --json",
    "harness:package": "node --import tsx scripts/harness-package.ts manifest",
    "harness:package:json": "node --import tsx scripts/harness-package.ts manifest --json",
    "harness:init-feature": "node --import tsx scripts/harness-init-feature.ts",
    "harness:product-intake": "node --import tsx scripts/harness-product-intake.ts",
    "harness:stitch-prompt": "node --import tsx scripts/harness-stitch-prompt.ts",
    "test:extensions": "node --import tsx --test tests/extension-units/*.test.ts",
    "test:queue-runner": "node --import tsx --test tests/extension-units/queue-runner.test.ts",
    "test:core-workflows": "node --import tsx --test tests/integration/core-workflows.test.ts",
    "test:operator-surface": "node --import tsx --test tests/integration/operator-surface.test.ts",
    "test:scheduled-workflows": "node --import tsx --test tests/integration/scheduled-workflows.test.ts",
    "test:worktree-helper": "node --import tsx --test tests/integration/worktree-helper.test.ts",
    "test:harness-package": "node --import tsx --test tests/integration/harness-package.test.ts",
    "test:stitch-prompt": "node --import tsx --test tests/extension-units/stitch-prompt-generator.test.ts tests/integration/stitch-prompt.test.ts",
    "validate:phase-a-b": "./scripts/validate-phase-a-b.sh",
    "validate:extension-units": "./scripts/validate-extension-unit-tests.sh",
    "validate:harness-routing": "./scripts/validate-harness-routing.sh",
    "validate:queue-runner": "./scripts/validate-queue-runner.sh --skip-live",
    "validate:core-workflows": "./scripts/validate-core-workflows.sh",
    "validate:harness-package": "./scripts/validate-harness-package.sh",
    "validate:stitch-prompt": "./scripts/validate-stitch-prompts.sh",
    "validate:tuning-data": "./scripts/collect-harness-tuning-data.sh",
    "test:discovery-policy": "node --import tsx --test tests/extension-units/discovery-policy.test.ts",
    "test:domain-governance": "node --import tsx --test tests/extension-units/domain-governance.test.ts tests/integration/domain-governance.test.ts",
    "validate:domain-governance": "./scripts/validate-domain-governance.sh",
    "harness:stitch-artifact": "node --import tsx scripts/harness-stitch-artifact.ts",
    "test:stitch-artifact": "node --import tsx --test tests/extension-units/stitch-artifact-adapter.test.ts tests/integration/stitch-artifact.test.ts",
    "validate:stitch-artifact": "./scripts/validate-stitch-artifacts.sh",
    "harness:screen-approval": "node --import tsx scripts/harness-screen-approval.ts",
    "test:screen-approval": "node --import tsx --test tests/extension-units/screen-artifact-approval.test.ts tests/integration/screen-artifact-approval.test.ts",
    "validate:screen-approval": "./scripts/validate-screen-artifact-approval.sh"
  },
  "devDependencies": {
    "@mariozechner/pi-ai": "0.67.6",
    "@mariozechner/pi-coding-agent": "0.67.6",
    "@sinclair/typebox": "^0.34.41",
    "@types/node": "^24.5.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3"
  }
}
