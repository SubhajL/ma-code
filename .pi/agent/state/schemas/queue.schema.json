{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JobQueueState",
  "type": "object",
  "required": [
    "version",
    "paused",
    "activeJobId",
    "jobs"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "paused": {
      "type": "boolean"
    },
    "activeJobId": {
      "type": [
        "string",
        "null"
      ]
    },
    "jobs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "goal",
          "priority",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "goal": {
            "type": "string"
          },
          "priority": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "scope": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "blocked",
              "done",
              "failed"
            ]
          },
          "team": {
            "type": "string",
            "enum": [
              "planning",
              "build",
              "quality",
              "recovery"
            ]
          },
          "budget": {
            "type": "object",
            "properties": {
              "maxRetries": {
                "type": "integer",
                "minimum": 0
              },
              "maxRuntimeMinutes": {
                "type": "integer",
                "minimum": 1
              },
              "maxFailedValidations": {
                "type": "integer",
                "minimum": 0
              },
              "maxUnresolvedBlockers": {
                "type": "integer",
                "minimum": 0
              },
              "maxCostUsd": {
                "type": "number",
                "minimum": 0
              },
              "maxFilesChanged": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          },
          "stop_conditions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "approvalRequired": {
            "type": "boolean"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "acceptanceCriteria": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "taskClass": {
            "type": "string",
            "enum": [
              "research",
              "docs",
              "implementation",
              "runtime_safety"
            ]
          },
          "workType": {
            "type": "string",
            "enum": [
              "implementation",
              "docs_only",
              "research_only",
              "review_only",
              "mixed"
            ]
          },
          "domains": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "frontend",
                "backend",
                "infra",
                "docs",
                "research"
              ]
            }
          },
          "allowedPaths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "assignedRole": {
            "type": "string",
            "enum": [
              "orchestrator",
              "planning_lead",
              "build_lead",
              "quality_lead",
              "research_worker",
              "frontend_worker",
              "backend_worker",
              "infra_worker",
              "reviewer_worker",
              "validator_worker",
              "docs_worker",
              "recovery_worker"
            ]
          },
          "routeReason": {
            "type": "string",
            "enum": [
              "default",
              "task_simpler",
              "task_harder",
              "provider_failure",
              "budget_pressure",
              "recovery_recommendation",
              "human_override"
            ]
          },
          "budgetMode": {
            "type": "string",
            "enum": [
              "default",
              "balanced",
              "conserve",
              "high"
            ]
          },
          "modelOverride": {
            "type": "string"
          },
          "qualityInput": {
            "description": "Structured runtime input for supported bounded quality-lane pickups. Current supported paths are queued quality_lead jobs via worker_to_quality and queued validator_worker jobs via quality_to_validator.",
            "type": [
              "object",
              "null"
            ],
            "required": [
              "sourcePacketId",
              "sourceHandoff"
            ],
            "properties": {
              "sourcePacketId": {
                "type": "string"
              },
              "sourceHandoff": {
                "description": "Structured handoff object whose handoffType and toRole must match the queued supported quality role.",
                "$ref": "./handoff.schema.json"
              }
            },
            "additionalProperties": false
          },
          "linkedTaskId": {
            "type": [
              "string",
              "null"
            ]
          },
          "packetId": {
            "type": [
              "string",
              "null"
            ]
          },
          "selectedModelId": {
            "type": [
              "string",
              "null"
            ]
          },
          "initialHandoffId": {
            "type": [
              "string",
              "null"
            ]
          },
          "lastRecoveryAction": {
            "type": "string",
            "enum": [
              "retry_same_lane",
              "retry_stronger_model",
              "switch_provider",
              "rollback",
              "stop",
              "escalate"
            ]
          },
          "lastRecoveryReason": {
            "type": "string"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "startedAt": {
            "type": "string"
          },
          "finishedAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          },
          "graphifyOrchestration": {
            "description": "Explicit bounded Graphify orchestration request for research queue jobs during run_bounded_queue_session. Ignored unless enabled=true and the job is research-scoped.",
            "type": [
              "object",
              "null"
            ],
            "required": [
              "enabled",
              "need"
            ],
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "need": {
                "type": "string",
                "enum": [
                  "none",
                  "exact_verification",
                  "broad_structure",
                  "architecture_review"
                ]
              },
              "graphifyAvailable": {
                "type": "boolean"
              },
              "localFallbackAllowed": {
                "type": "boolean"
              },
              "graphPresent": {
                "type": "boolean"
              },
              "freshnessStatus": {
                "type": "string",
                "enum": [
                  "fresh",
                  "stale_head",
                  "dirty_worktree",
                  "missing_metadata",
                  "missing_graph"
                ]
              },
              "purpose": {
                "type": "string",
                "enum": [
                  "architecture_review",
                  "dependency_exploration",
                  "drift_analysis",
                  "large_subsystem_mapping",
                  "curated_research"
                ]
              },
              "sourcePath": {
                "type": "string"
              },
              "taskId": {
                "type": "string"
              },
              "outputPath": {
                "type": "string"
              },
              "query": {
                "type": "string"
              },
              "preflightToken": {
                "type": "string"
              },
              "preflightTokenPresent": {
                "type": "boolean"
              },
              "cadencePhase": {
                "type": "string",
                "enum": [
                  "before_broad_planning",
                  "implementation_loop",
                  "after_structural_change",
                  "before_final_validation"
                ]
              },
              "largeCorpus": {
                "type": "boolean"
              },
              "approvedLargeCorpus": {
                "type": "boolean"
              },
              "maxFilesWithoutApproval": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100000
              },
              "latestRelevantGraphQueried": {
                "type": "boolean"
              },
              "importantClaimsSourceVerified": {
                "type": "boolean"
              },
              "explicitBlocker": {
                "type": "boolean"
              },
              "extraArgs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "timeoutMs": {
                "type": "integer",
                "minimum": 1000,
                "maximum": 300000
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
