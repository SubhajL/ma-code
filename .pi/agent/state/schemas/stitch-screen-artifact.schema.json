{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi.local/schemas/stitch-screen-artifact.schema.json",
  "title": "Stitch Screen Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "initiativeId",
    "sliceId",
    "artifactId",
    "mode",
    "phase",
    "status",
    "sourcePrompt",
    "screens",
    "constraints",
    "nextAllowedPhase",
    "nextBlockedUntil"
  ],
  "properties": {
    "version": { "const": 1 },
    "initiativeId": { "type": "string", "minLength": 1 },
    "sliceId": { "type": "string", "minLength": 1 },
    "artifactId": { "type": "string", "minLength": 1 },
    "mode": { "const": "mock" },
    "phase": { "const": "stitch_generation" },
    "status": { "enum": ["generated_mock", "blocked"] },
    "sourcePrompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["promptPath", "promptMetadataPath", "promptHash"],
      "properties": {
        "promptPath": { "type": "string", "pattern": "^docs/initiatives/[^/]+/stitch-prompts/[^/]+\\.prompt\\.md$" },
        "promptMetadataPath": { "type": "string", "pattern": "^docs/initiatives/[^/]+/stitch-prompts/[^/]+\\.prompt\\.json$" },
        "promptHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "screens": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["screenId", "name", "purpose", "states", "dataNeeds", "accessibilityNotes", "mockOnly"],
        "properties": {
          "screenId": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "states": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "dataNeeds": {
            "type": "array",
            "items": { "type": "string" }
          },
          "accessibilityNotes": {
            "type": "array",
            "items": { "type": "string" }
          },
          "mockOnly": { "const": true }
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["liveStitchCalled", "taskPacketsCreated", "queueJobsCreated"],
      "properties": {
        "liveStitchCalled": { "const": false },
        "taskPacketsCreated": { "const": false },
        "queueJobsCreated": { "const": false }
      }
    },
    "nextAllowedPhase": { "const": "screen_approval" },
    "nextBlockedUntil": { "const": "human_artifact_review" }
  }
}
