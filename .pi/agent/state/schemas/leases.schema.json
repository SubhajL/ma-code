{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExecutionLeaseState",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "leases"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "leases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "scope",
          "owner",
          "acquiredAt",
          "expiresAt",
          "heartbeatAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "acquiredAt": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string"
          },
          "heartbeatAt": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
