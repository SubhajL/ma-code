{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi.local/schemas/issue-materialization-source.schema.json",
  "title": "Issue Materialization Source",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "initiativeId", "source", "issues"],
  "properties": {
    "version": { "const": 1 },
    "initiativeId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "capturedAt"],
      "properties": {
        "kind": { "const": "g-issues" },
        "capturedAt": { "type": "string", "minLength": 1 },
        "approvedBy": { "type": "string", "minLength": 1 },
        "approvalRef": { "type": "string", "minLength": 1 }
      }
    },
    "issues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "issueId",
          "title",
          "type",
          "status",
          "dependencies",
          "userStoriesCovered",
          "whatToBuild",
          "acceptanceCriteria",
          "validationProof",
          "domains",
          "filesToModify",
          "allowedPaths",
          "schemaPaths",
          "migrationPaths",
          "configPaths",
          "testPaths",
          "fixturePaths",
          "hitlGates",
          "queueReadiness"
        ],
        "properties": {
          "issueId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "title": { "type": "string", "minLength": 1 },
          "type": { "enum": ["HITL", "AFK"] },
          "status": { "enum": ["planned", "blocked", "done"] },
          "dependencies": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "userStoriesCovered": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "whatToBuild": { "type": "string", "minLength": 1 },
          "acceptanceCriteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "validationProof": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "domains": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "filesToModify": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/repoPath" } },
          "allowedPaths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                { "$ref": "#/$defs/repoPath" },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["path"],
                  "properties": {
                    "path": { "$ref": "#/$defs/repoPath" },
                    "access": { "enum": ["read_only", "non_mutating", "read_write", "mutating"] },
                    "mutating": { "type": "boolean" }
                  }
                }
              ]
            }
          },
          "schemaPaths": { "type": "array", "items": { "$ref": "#/$defs/repoPath" } },
          "migrationPaths": { "type": "array", "items": { "$ref": "#/$defs/repoPath" } },
          "configPaths": { "type": "array", "items": { "$ref": "#/$defs/repoPath" } },
          "testPaths": { "type": "array", "items": { "$ref": "#/$defs/repoPath" } },
          "fixturePaths": { "type": "array", "items": { "$ref": "#/$defs/repoPath" } },
          "hitlGates": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "queueReadiness": { "const": "not_ready" }
        }
      }
    }
  },
  "$defs": {
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "(^/|(^|/)\\.\\.(/|$)|\\\\)" }
    }
  }
}
