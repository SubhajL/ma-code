{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskPacket",
  "type": "object",
  "required": [
    "version",
    "packetId",
    "source",
    "assignedTeam",
    "assignedRole",
    "title",
    "goal",
    "scope",
    "nonGoals",
    "workType",
    "domains",
    "discoverySummary",
    "crossModelPlanningNote",
    "filesToInspect",
    "filesToModify",
    "allowedPaths",
    "disallowedPaths",
    "acceptanceCriteria",
    "evidenceExpectations",
    "validationExpectations",
    "expectedProof",
    "wiringChecks",
    "migrationPathNote",
    "escalationInstructions",
    "dependencies",
    "modelOverride",
    "routing"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "packetId": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "required": [
        "goalId",
        "parentTaskId",
        "parentPacketId",
        "generatedAt"
      ],
      "properties": {
        "goalId": {
          "type": "string"
        },
        "parentTaskId": {
          "type": [
            "string",
            "null"
          ]
        },
        "parentPacketId": {
          "type": [
            "string",
            "null"
          ]
        },
        "generatedAt": {
          "type": "string"
        }
      }
    },
    "assignedTeam": {
      "type": "string",
      "enum": [
        "planning",
        "build",
        "quality",
        "recovery"
      ]
    },
    "assignedRole": {
      "type": "string",
      "enum": [
        "orchestrator",
        "planning_lead",
        "build_lead",
        "quality_lead",
        "research_worker",
        "frontend_worker",
        "backend_worker",
        "infra_worker",
        "reviewer_worker",
        "validator_worker",
        "docs_worker",
        "recovery_worker"
      ]
    },
    "title": {
      "type": "string"
    },
    "goal": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "nonGoals": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "workType": {
      "type": "string",
      "enum": [
        "implementation",
        "docs_only",
        "research_only",
        "review_only",
        "mixed"
      ]
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "frontend",
          "backend",
          "infra",
          "docs",
          "research"
        ]
      }
    },
    "discoverySummary": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "crossModelPlanningNote": {
      "type": "string"
    },
    "filesToInspect": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "filesToModify": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowedPaths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "disallowedPaths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "acceptanceCriteria": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "evidenceExpectations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "validationExpectations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "expectedProof": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "wiringChecks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "migrationPathNote": {
      "type": "string"
    },
    "escalationInstructions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "modelOverride": {
      "type": [
        "string",
        "null"
      ]
    },
    "routing": {
      "type": "object",
      "required": [
        "reason",
        "budgetMode",
        "selectedModelId",
        "selectedProvider",
        "selectedModel",
        "source"
      ],
      "properties": {
        "reason": {
          "type": "string"
        },
        "budgetMode": {
          "type": "string"
        },
        "selectedModelId": {
          "type": "string"
        },
        "selectedProvider": {
          "type": "string"
        },
        "selectedModel": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      }
    },
    "tddSlice": {
      "description": "Optional structured TDD slice metadata that carries the first tracer behavior, public interface, test surface, boundary dependencies, mock plan, and intentionally excluded behaviors.",
      "type": [
        "object",
        "null"
      ],
      "required": [
        "firstTracerBehavior",
        "publicInterface",
        "testSurface",
        "boundaryDependencies",
        "mockPlan",
        "outOfScopeBehaviors"
      ],
      "properties": {
        "firstTracerBehavior": {
          "type": "string",
          "minLength": 1
        },
        "publicInterface": {
          "type": "string",
          "minLength": 1
        },
        "testSurface": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "boundaryDependencies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "mockPlan": {
          "type": "string",
          "minLength": 1
        },
        "outOfScopeBehaviors": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    },
    "graphifyEvidence": {
      "description": "Optional structured Graphify evidence expectations or proof for Graphify-backed or architecture-review claims. This is evidence metadata only and does not make Graphify mandatory.",
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "graphifyBackedClaim": {
          "type": "boolean"
        },
        "claimScope": {
          "type": "string",
          "enum": [
            "graphify_backed_claim",
            "architecture_review",
            "other"
          ]
        },
        "policy": {
          "type": "string",
          "enum": [
            "optional_default",
            "required_for_graphify_backed_claims",
            "required_for_architecture_review",
            "disabled"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "latestRelevantGraphQueried": {
          "type": "boolean"
        },
        "freshnessOrCadenceChecked": {
          "type": "boolean"
        },
        "importantClaimsSourceVerified": {
          "type": "boolean"
        },
        "graphifyValidationState": {
          "type": "string"
        },
        "graphifyOrchestrationAction": {
          "type": "string"
        },
        "graphifyAdapterAction": {
          "type": "string"
        },
        "graphifyArtifactPath": {
          "type": "string"
        },
        "sourceVerificationNotes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
